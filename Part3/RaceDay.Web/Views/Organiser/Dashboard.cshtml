@model DashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
    var next = Model.Upcoming.FirstOrDefault();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="rd-heading mb-0">Dashboard</h1>
    <a asp-action="CreateEvent" class="btn btn-rd">+ New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3"><div class="stat-tile"><span>@Model.Events.Count</span>Events created</div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat-tile"><span>@Model.TotalEnrolments</span>Total enrolments</div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat-tile"><span>@Model.Upcoming.Count</span>Upcoming events</div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat-tile stat-tile-accent"><span>@(next is null ? "-" : next.EventDate.ToString("d MMM"))</span>Next race day</div></div>
</div>

@if (Model.Events.Count == 0)
{
    <div class="rd-card text-center py-5">
        <p class="lead">You have not created any events yet.</p>
        <a asp-action="CreateEvent" class="btn btn-rd">Create your first event</a>
    </div>
}
else
{
    <div class="rd-card">
        <h2 class="rd-subheading">My events</h2>
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Type</th><th>Distances</th><th>Enrolments</th><th>Status</th><th class="text-end">Manage</th></tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.Events)
                    {
                        <tr>
                            <td><a asp-controller="Home" asp-action="Details" asp-route-id="@ev.EventId"><strong>@ev.EventName</strong></a><div class="small text-muted">@ev.City</div></td>
                            <td>@ev.EventDate.ToString("d MMM yyyy")</td>
                            <td>@ev.DisciplineName</td>
                            <td class="small">@Ui.Distances(ev.DistancesKm)</td>
                            <td><strong>@ev.EnrolmentCount</strong></td>
                            <td><span class="@Ui.BadgeClass(ev.Status)">@ev.Status</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Categories" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Categories</a>
                                <a asp-action="Enrolments" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                                <a asp-action="Results" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Results</a>
                                <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline" onsubmit="return confirm('Delete @ev.EventName? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
