@model CategoriesViewModel
@{
    ViewData["Title"] = $"Categories: {Model.Event.EventName}";
}
<p class="mb-1"><a asp-action="Dashboard">&larr; Dashboard</a></p>
<h1 class="rd-heading mb-1">Categories</h1>
<p class="text-muted mb-4">@Model.Event.EventName · @Model.Event.EventDate.ToString("d MMMM yyyy")</p>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card">
            <h2 class="rd-subheading">Current categories</h2>
            @if (Model.Categories.Count == 0)
            {
                <p class="mb-0">No categories yet. Add the first one using the form.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead><tr><th>Name</th><th>Distance</th><th>Fee</th><th>Min age</th><th>Entries</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.Categories)
                            {
                                <tr>
                                    <td><strong>@c.CategoryName</strong></td>
                                    <td>@c.DistanceKm.ToString("0.##") km</td>
                                    <td>@Ui.Rand(c.EntryFee)</td>
                                    <td>@(c.MinimumAge > 0 ? $"{c.MinimumAge}+" : "Any")</td>
                                    <td>@c.EnrolledCount@(c.MaxParticipants is int max ? $" / {max}" : "")</td>
                                    <td class="text-end">
                                        <form asp-action="DeleteCategory" asp-route-id="@Model.Event.EventId" method="post" class="d-inline" onsubmit="return confirm('Remove @c.CategoryName?');">
                                            <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-card">
            <h2 class="rd-subheading">Add a category</h2>
            <p class="small text-muted">Use age groups (Under 20, Senior, Veteran) or distances (5 km, 10 km, 21.1 km).</p>
            <form asp-action="AddCategory" asp-route-id="@Model.Event.EventId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                    <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g. 21.1 km Half Marathon" />
                    <span asp-validation-for="NewCategory.CategoryName" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="NewCategory.DistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.EntryFee" class="form-label"></label>
                        <input asp-for="NewCategory.EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.EntryFee" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
                        <input asp-for="NewCategory.MaxParticipants" type="number" min="1" class="form-control" placeholder="No limit" />
                        <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.MinimumAge" class="form-label"></label>
                        <input asp-for="NewCategory.MinimumAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="NewCategory.MinimumAge" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.CategoryStartTime" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryStartTime" type="time" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-rd w-100">Add category</button>
            </form>
        </div>
    </div>
</div>
