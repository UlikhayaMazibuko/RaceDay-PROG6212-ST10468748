@model List<Enrolment>
@{
    ViewData["Title"] = "My events";
    var today = DateOnly.FromDateTime(DateTime.Today);
}
<h1 class="rd-heading mb-4">My events</h1>

@if (Model.Count == 0)
{
    <div class="rd-card text-center py-5">
        <p class="lead">You have not entered any events yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Browse events</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Race number</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var en in Model.OrderBy(e => e.EventDate))
                    {
                        <tr>
                            <td><a asp-controller="Home" asp-action="Details" asp-route-id="@en.EventId"><strong>@en.EventName</strong></a></td>
                            <td>@en.EventDate.ToString("d MMM yyyy")</td>
                            <td>@en.CategoryName (@en.DistanceKm.ToString("0.##") km)</td>
                            <td><span class="race-number">@en.RaceNumber</span></td>
                            <td><span class="@Ui.BadgeClass(en.EnrolmentStatus)">@en.EnrolmentStatus</span></td>
                            <td class="text-end">
                                @if (en.EventDate > today && !en.HasResult)
                                {
                                    <form asp-action="Withdraw" method="post" class="d-inline" onsubmit="return confirm('Withdraw from @en.EventName?');">
                                        <input type="hidden" name="enrolmentId" value="@en.EnrolmentId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
