@model ErrorViewModel
@{
    ViewData["Title"] = "Oops";
}
<div class="rd-card text-center py-5">
    <div class="display-5 rd-heading">@(Model.StatusCode?.ToString() ?? "Oops")</div>
    <p class="lead mb-4">@Model.Message</p>
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
